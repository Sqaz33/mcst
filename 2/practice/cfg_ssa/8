L0:
%i1 = 0
%sum1 = 0
%x1 = %a
goto L1

L1:
%sum2 = phi([%sum1, L0], [%sum3, L3], [%sum4, L5]) 
%x2 = phi([%x1, L0], [%x3, L3], [%x4, L5]) 
%i2 = phi([%i1, L0], [%i3, L3], [%i4, L5]) 
if %i2 < %n goto L2 else goto L6

L2:
if %x2 < 0 goto L3 else goto L4

L3:
%x3 = 0 - %x2
%i3 = %i2 + 1
%sum3 = %sum2 + 1
goto L1

L4:
%sum4 = %sum2 + %x2
if %sum4 < %limit goto L5 else goto L6

L5:
%i4 = %i2 + 1
%x4 = %x2 - 2
goto L1

L6:
%sum5 = phi([%sum2, L1], [%sum4, L4])
%result1 = %sum5 + %x2
return %result1